# Production URL (canonicals, sitemap, share cards)
NEXT_PUBLIC_SITE_URL=

# Assistant (server-only). Leave empty to hide the Ask button.
GEMINI_API_KEY=
GEMINI_MODEL=

# Contact form (web3forms.com access key; public by design). Leave empty to hide the "Send a message" tab.
WEB3FORMS_ACCESS_KEY=

# Optional shared rate limit for the assistant
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
